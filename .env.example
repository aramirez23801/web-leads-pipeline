# Outscraper API
OUTSCRAPER_API_KEY=<your_key_here>

# Default neighborhood (override via CLI: --neighborhood retiro)
NEIGHBORHOOD_NAME=maria_de_molina

# Claude API (stages 6 + 8)
ANTHROPIC_API_KEY=<your_key_here>

# Cloudflare Pages (stage 9)
CLOUDFLARE_ACCOUNT_ID=<your_account_id>
CLOUDFLARE_API_TOKEN=<pages_edit_token>
CLOUDFLARE_PAGES_PROJECT=mejoraweb-mockups

# Reference only — not used for cold email
FROM_EMAIL=andres@mejoraweb.app
